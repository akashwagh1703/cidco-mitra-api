APP_NAME="CIDCO Mitra API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://cidcomitra.com/cidco-mitra-api/public

DB_CONNECTION=mysql
# Prefer 127.0.0.1 over localhost on some hosts (avoids socket / IPv6 issues)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cidcomit1_web
DB_USERNAME=YOUR_DB_USER
# Quote passwords that contain $ @ # etc.
DB_PASSWORD="YOUR_DB_PASSWORD"

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

SANCTUM_STATEFUL_DOMAINS=cidcomitra.com,www.cidcomitra.com
SANCTUM_TOKEN_EXPIRATION=10080
CORS_ALLOWED_ORIGINS=https://cidcomitra.com,https://www.cidcomitra.com
SESSION_SECURE_COOKIE=true
LOG_LEVEL=error
